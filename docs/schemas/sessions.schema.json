{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/sessions.schema.json",
  "title": "sonde sessions -f json",
  "description": "The sessions recorded, newest first.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "The file's name."
      },
      "path": {
        "type": "string"
      },
      "created": {
        "type": "string"
      },
      "program": {
        "type": [
          "string",
          "null"
        ],
        "description": "The program it is a run of: its `[program] name`, else its command with what changes between runs said as what it is (`--date {date}`) and a trial's place left out; null for a replay, an import or a recording without a command."
      },
      "command": {
        "type": "string",
        "description": "The command it ran, as it ran it; absent when none."
      },
      "endpoint": {
        "type": "string"
      },
      "bytes": {
        "type": "integer",
        "description": "The file's size."
      },
      "requests": {
        "type": "integer"
      },
      "seconds": {
        "type": "number"
      },
      "errors": {
        "type": "integer"
      },
      "trials": {
        "type": "string",
        "description": "Its last trial, in short."
      },
      "exit": {
        "type": "integer",
        "description": "How its program exited (128 + a signal; 143 when sonde was sent SIGTERM); absent when not known (a proxy's, a replay's, an import's)."
      }
    },
    "required": [
      "name",
      "path",
      "created",
      "program",
      "endpoint",
      "bytes",
      "requests",
      "seconds",
      "errors"
    ]
  }
}
