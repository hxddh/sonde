        "waitingKnown": {
          "type": "boolean",
          "description": "Whether both runs' waiting is known: false when either's times are to the second (an imported log's); `waitingMs` then says nothing."
        },
        "commandChanged": {
          "type": "string",
          "description": "Display text, not stable: how the command changed between two runs of one program (a named one's), `--limit 200 → 20`. Present only then: fixed, less and more carry no `measured` or `saved`."
        },
        "workloadChanged": {
          "type": "string",
          "description": "Display text, not stable: how much the workload changed between two runs of one program with the same command (`requests 120 → 402, 3.4×`): grown by half or more, or shrunk by a third or more below what fixing the first run's findings would leave. Present only then: what moved is the workload's doing as much as a fix's, and fixed, less and more carry no `measured` or `saved`."
        },
        "endpoints": {
          "type": "array",
