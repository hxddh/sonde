{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/show.schema.json",
  "title": "sonde show -f json",
  "description": "A run: what it amounts to and its findings, each cut to what to change and where (`show -f json`). `--all` adds every operation and each finding's operations and fixes whole; `--errors` adds the failed operations; `--requests` adds the requests (with `--errors`, the failed ones).",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "#/$defs/runHeader"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "operationsTotal": {
      "type": "integer",
      "description": "How many operations the run has."
    },
    "waiting": {
      "type": "object",
      "description": "How long the program waited on the store.",
      "properties": {
        "waitingMs": {
          "type": "number",
          "description": "Time with any request in flight."
        },
        "wallMs": {
          "type": "number",
          "description": "The run's length."
        },
        "peakInFlight": {
          "type": "integer"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "p99Ms": {
          "type": "number"
        },
        "byKind": {
          "type": "array",
          "description": "Each kind of request's share.",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      },
      "required": [
        "waitingMs",
        "wallMs",
        "peakInFlight",
        "p50Ms",
        "p95Ms",
        "p99Ms",
        "byKind"
      ]
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "month": {
      "anyOf": [
        {
          "$ref": "#/$defs/month"
        },
        {
          "type": "null"
        }
      ]
    },
    "whatIf": {
      "description": "The run with every finding's fix; null when no finding names what its fix saves (none, or none that can be counted).",
      "anyOf": [
        {
          "$ref": "#/$defs/whatIf"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "description": "The findings, those that save the most money first, then those that save time, then the rest."
    },
    "verify": {
      "type": [
        "string",
        "null"
      ],
      "description": "The command that records the program again, in the folder it ran in (`run.cwd`), to see a fix work: then `since.findings[].state` says fixed, less, more, new, back or open. Null for a run that is no program's (an import, a replay)."
    },
    "trials": {
      "type": "array",
      "description": "The run's last trial, scenario by scenario, each with its history (`sonde run --trial`).",
      "items": {
        "$ref": "#/$defs/trial"
      }
    },
    "since": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "program": {
          "type": "string",
          "description": "The program, as its runs are grouped (empty when the run is no run of a program, with `--since`)."
        },
        "previous": {
          "type": "string",
          "description": "The earlier run compared, by path: the program's run before, or the run `--since` names. Absent for a program's first run."
        },
        "change": {
          "$ref": "#/$defs/change"
        },
        "findings": {
          "type": "array",
          "description": "Each finding of either run, with its `state`: fixed, less, more, back, new or open.",
          "items": {
            "type": "object"
          }
        },
        "empty": {
          "type": "boolean",
          "description": "True: the run recorded no request (nothing reached sonde); it is not compared."
        },
        "failed": {
          "type": "integer",
          "description": "The exit code of a run that failed: not compared."
        }
      },
      "description": "The run against its program's run before it, or against the run `--since` names, as `show` says it under \"since …\": `program`, `previous`, `change`, `findings`; or `failed` (the exit code of a run that failed: not compared), or `empty` (true: the run recorded no request, nothing reached sonde; not compared). Null for a run that is no run of a program and no `--since`."
    },
    "operations": {
      "type": "array",
      "description": "With `--all`: every operation, in order; with `--errors`: those that failed.",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "requests": {
      "type": "array",
      "description": "With `--requests`: every request, as the file has it.",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "run",
    "summary",
    "operationsTotal",
    "waiting",
    "cost",
    "month",
    "whatIf",
    "findings",
    "verify",
    "trials"
  ],
  "$defs": {
    "cost": {
      "type": "object",
      "description": "What the run cost at the endpoint's prices (docs/cli.md#cost): its requests, its bytes out, and apart what it left stored a month.",
      "properties": {
        "amount": {
          "type": "number",
          "description": "The run's money: `requests`, and `transfer.amount` when `transfer.egress` is `charged`."
        },
        "currency": {
          "type": "string"
        },
        "reads": {
          "type": "integer"
        },
        "writes": {
          "type": "integer"
        },
        "free": {
          "type": "integer"
        },
        "requests": {
          "type": "number",
          "description": "Of `amount`, the requests'."
        },
        "transfer": {
          "type": "object",
          "description": "The bytes the store sent.",
          "properties": {
            "bytes": {
              "type": "integer"
            },
            "egress": {
              "type": "string",
              "enum": [
                "charged",
                "free",
                "unknown"
              ],
              "description": "`charged`: read from outside the store's region (the endpoint's `egress = true`); `free`: read in it (`egress = false`) or a store with no egress fee; `unknown`: not said, so not in `amount` (`amount` here is what it would be if read from outside the region)."
            },
            "amount": {
              "type": "number",
              "description": "The bytes at the egress price (0 when `free`)."
            },
            "perGib": {
              "type": "number"
            }
          },
          "required": [
            "bytes",
            "egress",
            "amount",
            "perGib"
          ]
        },
        "storage": {
          "type": "object",
          "description": "What the run left stored, a month (not in `amount`).",
          "properties": {
            "bytes": {
              "type": "integer",
              "description": "Bytes it wrote and did not delete."
            },
            "perMonth": {
              "type": "number"
            },
            "versioned": {
              "type": "boolean",
              "description": "A write's answer said the bucket keeps versions."
            },
            "noncurrent": {
              "type": "integer",
              "description": "Versions its overwrites and deletes made noncurrent there."
            },
            "noncurrentBytes": {
              "type": "integer",
              "description": "The bytes of those whose size the run saw."
            },
            "noncurrentPerMonth": {
              "type": "number",
              "description": "What they cost a month until a lifecycle rule expires them."
            }
          },
          "required": [
            "bytes",
            "perMonth",
            "versioned",
            "noncurrent",
            "noncurrentBytes",
            "noncurrentPerMonth"
          ]
        }
      },
      "required": [
        "amount",
        "currency",
        "reads",
        "writes",
        "free",
        "requests",
        "transfer",
        "storage"
      ]
    },
    "git": {
      "type": "object",
      "description": "The commit the program's code was at.",
      "properties": {
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean",
          "description": "Changes not committed yet."
        }
      },
      "required": [
        "commit",
        "dirty"
      ]
    },
    "group": {
      "type": "object",
      "description": "A kind of request.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "missed": {
          "type": "boolean",
          "description": "Lookups that found nothing, apart."
        },
        "requests": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "waitingMs": {
          "type": "number",
          "description": "Time with one of these in flight."
        },
        "sumMs": {
          "type": "number"
        },
        "waitedMs": {
          "type": "number"
        },
        "share": {
          "type": "number"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "maxMs": {
          "type": "number"
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "cost": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "missed",
        "requests",
        "errors",
        "waitingMs",
        "p50Ms",
        "p95Ms"
      ]
    },
    "observation": {
      "type": "object",
      "description": "A finding.",
      "properties": {
        "level": {
          "type": "string",
          "description": "`warn` (likely a problem) or `info`.",
          "enum": [
            "warn",
            "info"
          ]
        },
        "text": {
          "type": "string",
          "description": "Display text, not stable: in English."
        },
        "phrases": {
          "type": "array",
          "description": "Display text, not stable: the same, as phrases.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "operations": {
          "type": "array",
          "description": "The operations it is about (their places in the run's operations): the first 20 (all with `--all`).",
          "items": {
            "type": "integer"
          }
        },
        "operationsTotal": {
          "type": "integer",
          "description": "How many operations it is about."
        },
        "impact": {
          "type": "integer",
          "description": "Requests it is about."
        },
        "identity": {
          "type": "string",
          "description": "The same finding across runs: what `[check] expect` names."
        },
        "expected": {
          "type": "string",
          "description": "Why the project keeps it on purpose (`[check] expect` in the run's sonde.toml): leave it."
        },
        "kind": {
          "type": "string",
          "enum": [
            "obs.unfinished",
            "obs.orphans",
            "obs.small",
            "obs.hot",
            "obs.rangeagain",
            "obs.wholeread",
            "obs.smallreads",
            "obs.listed",
            "obs.crawl",
            "obs.headget",
            "obs.deletes",
            "obs.rmw",
            "obs.polled",
            "obs.rename",
            "obs.markers",
            "obs.throttled",
            "obs.serial"
          ],
          "description": "What kind of finding it is, as `identity` begins (docs/cli.md#findings)."
        },
        "saving": {
          "$ref": "#/$defs/phrase"
        },
        "savingText": {
          "type": "string",
          "description": "Display text, not stable."
        },
        "savesRequests": {
          "type": "integer"
        },
        "savesMs": {
          "type": "number"
        },
        "savesBytes": {
          "type": "integer",
          "description": "Bytes it would not read out of the store."
        },
        "savesCost": {
          "type": "number",
          "description": "What the requests and bytes it would save cost, in the run's currency (times `month.times`: a month); bytes count only when `cost.transfer.egress` is `charged`."
        },
        "fixes": {
          "type": "array",
          "description": "How to fix it: the engine's setting where its requests are an engine's (SlateDB, DuckDB, rclone, …), else the fix for the run's SDK, or a store's setting (each SDK's with `--all`).",
          "items": {
            "type": "object",
            "properties": {
              "sdk": {
                "type": "string",
                "description": "`python`, `java`, `go`, `js`, `rust` (object_store), or `config` for a store's or an engine's setting."
              },
              "code": {
                "type": "string",
                "description": "The change, its first line a comment that says it. An SDK's has placeholders (`b` the bucket, `k` the key); an engine's names the real ones."
              },
              "setting": {
                "type": "object",
                "description": "The engine's setting it changes: the one edit to make.",
                "properties": {
                  "engine": {
                    "type": "string",
                    "description": "The engine or tool: `SlateDB DbReader`, `DuckDB`, `rclone`, `Hadoop s3a`, …"
                  },
                  "key": {
                    "type": "string",
                    "description": "The setting's own name: `manifest_poll_interval`, `--s3-no-head-object`, `fs.s3a.committer.name`."
                  },
                  "value": {
                    "type": "string",
                    "description": "The value to give it, as the engine reads it."
                  },
                  "where": {
                    "type": "string",
                    "description": "`file:line` (relative to `run.cwd`) where the program's folder sets it now; absent when sonde finds none."
                  }
                },
                "required": [
                  "engine",
                  "key",
                  "value"
                ]
              }
            },
            "required": [
              "sdk",
              "code"
            ]
          }
        },
        "callers": {
          "type": "array",
          "description": "Where its requests were sent from, most first (three at most): a place in the program's code when the run named callers; for an imported log, who sent them (an IAM principal).",
          "items": {
            "type": "object",
            "properties": {
              "place": {
                "type": "string",
                "description": "As the program or the log said it: `etl.py:25 process`, `arn:aws:iam::1:role/etl`."
              },
              "file": {
                "type": "string",
                "description": "The file, relative to the folder the program ran in (`run.cwd`), when `place` is a place in code."
              },
              "line": {
                "type": "integer"
              },
              "function": {
                "type": "string"
              },
              "requests": {
                "type": "integer",
                "description": "How many of its requests were sent from there."
              },
              "code": {
                "type": "string",
                "description": "The line of code itself, when the file is there to read."
              }
            },
            "required": [
              "place",
              "requests"
            ]
          }
        },
        "sdk": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "text",
        "phrases",
        "operations",
        "impact",
        "operationsTotal"
      ]
    },
    "kindSummary": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "misses": {
          "type": "integer",
          "description": "404s that answer a lookup."
        },
        "errorShare": {
          "type": "number"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "p99Ms": {
          "type": "number"
        },
        "maxMs": {
          "type": "number"
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "few": {
          "type": "boolean",
          "description": "Too few requests for its percentiles to say much."
        }
      },
      "required": [
        "kind",
        "count",
        "errors",
        "misses",
        "errorShare",
        "p50Ms",
        "p95Ms",
        "p99Ms",
        "maxMs",
        "bytesUp",
        "bytesDown"
      ]
    },
    "phrase": {
      "type": "object",
      "description": "A sentence as a key and its arguments: the app says it in the reader's language.",
      "properties": {
        "key": {
          "type": "string",
          "description": "The phrase's key in the app's locales (en, zh)."
        },
        "args": {
          "type": "object",
          "description": "Its arguments, as text.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "key"
      ]
    },
    "runHeader": {
      "type": "object",
      "description": "The run's first line: docs/dev/run-format.md.",
      "properties": {
        "format": {
          "type": "string",
          "description": "Always `sonde-run`.",
          "const": "sonde-run"
        },
        "version": {
          "type": "integer",
          "description": "The run format's version (docs/dev/run-format.md)."
        },
        "sonde": {
          "type": "string",
          "description": "The sonde that wrote the file (its version)."
        },
        "created": {
          "type": "string",
          "description": "When the recording began (RFC 3339)."
        },
        "endpoint": {
          "type": "string",
          "description": "The endpoint's id."
        },
        "url": {
          "type": "string",
          "description": "The endpoint's URL."
        },
        "region": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "description": "The command sonde ran, when it ran one."
        },
        "name": {
          "type": "string",
          "description": "The program's name (`[program] name`, `--name`)."
        },
        "cwd": {
          "type": "string",
          "description": "The folder the command ran in."
        },
        "git": {
          "$ref": "#/$defs/git"
        },
        "scenario": {
          "type": "string",
          "description": "A trial's fault scenario."
        },
        "trialOf": {
          "type": "string",
          "description": "The clean run a trial is of (its file name)."
        },
        "wholeSeconds": {
          "type": "boolean",
          "description": "Request times are to the second (an imported log)."
        }
      },
      "required": [
        "format",
        "version",
        "created",
        "endpoint",
        "url",
        "region"
      ]
    },
    "summary": {
      "type": "object",
      "description": "The run in figures.",
      "properties": {
        "requests": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "misses": {
          "type": "integer"
        },
        "refused": {
          "type": "integer",
          "description": "Refused by the recording's policy."
        },
        "seconds": {
          "type": "number",
          "description": "From the first request's start to the last one's end."
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "kinds": {
          "type": "array",
          "description": "Each kind of request.",
          "items": {
            "$ref": "#/$defs/kindSummary"
          }
        },
        "errorCodes": {
          "type": "array",
          "description": "Each error's status or code and its count.",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": [
                  "integer",
                  "string"
                ]
              },
              {
                "type": [
                  "integer",
                  "string"
                ]
              }
            ],
            "items": false
          }
        }
      },
      "required": [
        "requests",
        "errors",
        "misses",
        "refused",
        "seconds",
        "bytesUp",
        "bytesDown",
        "kinds",
        "errorCodes"
      ]
    },
    "whatIf": {
      "type": "object",
      "description": "The run as it is and as it would be with every finding's fix: each a pair.",
      "properties": {
        "requests": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "items": false
        },
        "bytesOut": {
          "type": "array",
          "description": "The bytes read out of the store.",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "items": false
        },
        "waitingMs": {
          "type": [
            "array",
            "null"
          ],
          "description": "Null when the run's times cannot say it (an imported log's, to the second).",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "cost": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "currency": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "description": "Findings whose fix is counted."
        },
        "ofFindings": {
          "type": "integer"
        },
        "counted": {
          "type": "array",
          "description": "The findings counted.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "requests",
        "bytesOut",
        "waitingMs",
        "cost",
        "currency",
        "findings",
        "ofFindings",
        "counted"
      ]
    },
    "trial": {
      "type": "object",
      "description": "A trial's verdict (docs/trials.md).",
      "properties": {
        "scenario": {
          "type": "string"
        },
        "about": {
          "type": "string"
        },
        "times": {
          "type": "integer"
        },
        "standing": {
          "type": "string",
          "enum": [
            "survived",
            "degraded",
            "broke",
            "untested",
            "refused"
          ],
          "description": "`refused`: the recording policy refused what the program did under the scenario (and not in its clean run): not judged, never `broke`."
        },
        "exit": {
          "type": "integer"
        },
        "cleanExit": {
          "type": "integer"
        },
        "faults": {
          "type": "integer"
        },
        "retried": {
          "type": "integer"
        },
        "attempts": {
          "type": "integer"
        },
        "where": {
          "type": "object",
          "description": "The request the verdict turns on, when it is not `survived`.",
          "properties": {
            "kind": {
              "type": "string",
              "description": "The S3 call (`PutObject`)."
            },
            "key": {
              "type": "string",
              "description": "`bucket/key`, or the bucket and what was listed."
            },
            "caller": {
              "type": "string",
              "description": "The line of the program that sent it (`etl.py:12 in save`), when the run named callers."
            }
          },
          "required": [
            "kind",
            "key"
          ]
        },
        "advice": {
          "type": "object",
          "description": "What to change, where the requests say: a phrase (`trial.advice.retry`, …), its arguments, and its English.",
          "properties": {
            "key": {
              "type": "string",
              "description": "The phrase's key in the app's locales (en, zh)."
            },
            "args": {
              "type": "object",
              "description": "Its arguments, as text.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "text": {
              "type": "string",
              "description": "The advice in English: no lookup needed."
            }
          },
          "required": [
            "key",
            "args",
            "text"
          ]
        },
        "history": {
          "type": "array",
          "description": "The scenario's verdicts for the program, oldest first, up to this one (kept in the runs folder's `.index.jsonl`).",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "description": "When (RFC 3339)."
              },
              "standing": {
