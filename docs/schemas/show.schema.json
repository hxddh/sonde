                  "type": "integer"
                }
              },
              "predicted": {
                "$ref": "#/$defs/saving",
                "description": "What acting on it was predicted to save."
              },
              "measured": {
                "$ref": "#/$defs/saving",
                "description": "What it saved, measured between the runs (fixed, less)."
              },
              "saved": {
                "$ref": "#/$defs/phrase"
              },
              "savedText": {
                "type": "string",
                "description": "Display text, not stable: the measured saving against the predicted."
              }
            },
            "required": [
              "identity",
              "state",
              "level",
              "text",
              "phrases",
              "predicted"
            ]
          }
