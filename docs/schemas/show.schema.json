          }
        },
        "requestBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "responseBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "errorBody": {
          "type": [
            "string",
            "null"
          ],
