    "operation": {
      "type": "object",
      "description": "An operation: requests that belong together.",
      "properties": {
        "shape": {
          "type": "string",
          "description": "The shape of the operation: what its requests are together (a request alone, a multipart upload, a retry, lookups that found nothing, a listing over pages, a step of a storage format). `kind` is a request's S3 call only.",
