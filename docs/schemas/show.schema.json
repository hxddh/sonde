{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/show.schema.json",
  "title": "sonde show -f json",
  "description": "A run: what it amounts to and its findings, each cut to what to change and where (`show -f json`). `--all` adds every operation and each finding's operations and fixes whole; `--errors` adds the failed operations; `--requests` adds the requests (with `--errors`, the failed ones).",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "#/$defs/runHeader"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "operationsTotal": {
      "type": "integer",
      "description": "How many operations the run has."
    },
    "waiting": {
      "type": "object",
      "description": "How long the program waited on the store.",
      "properties": {
        "waitingMs": {
          "type": "number",
          "description": "Time with any request in flight."
        },
        "wallMs": {
          "type": "number",
          "description": "The run's length."
        },
        "peakInFlight": {
          "type": "integer"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "p99Ms": {
          "type": "number"
        },
        "byKind": {
          "type": "array",
          "description": "Each kind of request's share.",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      },
      "required": [
        "waitingMs",
        "wallMs",
        "peakInFlight",
        "p50Ms",
        "p95Ms",
        "p99Ms",
        "byKind"
      ]
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "month": {
      "anyOf": [
        {
          "$ref": "#/$defs/month"
        },
        {
          "type": "null"
        }
      ]
    },
    "whatIf": {
      "description": "The run with every finding's fix; null when no finding names what its fix saves (none, or none that can be counted).",
      "anyOf": [
        {
          "$ref": "#/$defs/whatIf"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "description": "The findings, those that save the most money first, then those that save time, then the rest."
    },
    "verify": {
      "type": [
        "string",
        "null"
      ],
      "description": "The command that records the program again, in the folder it ran in (`run.cwd`), to see a fix work: then `since.findings[].state` says fixed, less, more, new, back or open. Null for a run that is no program's (an import, a replay)."
    },
    "trials": {
      "type": "array",
      "description": "The run's last trial, scenario by scenario, each with its history (`sonde run --trial`).",
      "items": {
        "$ref": "#/$defs/trial"
      }
    },
    "since": {
      "type": [
        "object",
        "null"
      ],
      "description": "The run against its program's run before it, as `show` says it under \"since the run before\": `program`, `previous`, `change` (as `compare -f json`), `findings` (each with its `state`: fixed, less, back, new, open), or `failed` (the exit code of a run that failed: not compared). Null for a run that is no run of a program."
    },
    "operations": {
      "type": "array",
      "description": "With `--all`: every operation, in order; with `--errors`: those that failed.",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "requests": {
      "type": "array",
      "description": "With `--requests`: every request, as the file has it.",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "run",
    "summary",
    "operationsTotal",
    "waiting",
    "cost",
    "month",
    "whatIf",
    "findings",
    "verify",
    "trials"
  ],
  "$defs": {
    "cost": {
      "type": "object",
      "description": "The requests' cost at the endpoint's prices.",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "reads": {
          "type": "integer"
        },
        "writes": {
          "type": "integer"
        },
        "free": {
          "type": "integer"
        }
      },
      "required": [
        "amount",
        "currency",
        "reads",
        "writes",
        "free"
      ]
    },
    "git": {
      "type": "object",
      "description": "The commit the program's code was at.",
      "properties": {
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean",
          "description": "Changes not committed yet."
        }
      },
      "required": [
        "commit",
        "dirty"
      ]
    },
    "group": {
      "type": "object",
      "description": "A kind of request.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "missed": {
          "type": "boolean",
          "description": "Lookups that found nothing, apart."
        },
        "requests": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "waitingMs": {
          "type": "number",
          "description": "Time with one of these in flight."
        },
        "sumMs": {
          "type": "number"
        },
        "waitedMs": {
          "type": "number"
        },
        "share": {
          "type": "number"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "maxMs": {
          "type": "number"
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "cost": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "missed",
        "requests",
        "errors",
        "waitingMs",
        "p50Ms",
        "p95Ms"
      ]
    },
    "observation": {
      "type": "object",
      "description": "A finding.",
      "properties": {
        "level": {
          "type": "string",
          "description": "`warn` (likely a problem) or `info`.",
          "enum": [
            "warn",
            "info"
          ]
        },
        "text": {
          "type": "string",
          "description": "Display text, not stable: in English."
        },
        "phrases": {
          "type": "array",
          "description": "Display text, not stable: the same, as phrases.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "operations": {
          "type": "array",
          "description": "The operations it is about (their places in the run's operations): the first 20 (all with `--all`).",
          "items": {
            "type": "integer"
          }
        },
        "operationsTotal": {
          "type": "integer",
          "description": "How many operations it is about."
        },
        "impact": {
          "type": "integer",
          "description": "Requests it is about."
        },
        "identity": {
          "type": "string",
          "description": "The same finding across runs: what `[check] expect` names."
        },
        "kind": {
          "type": "string",
          "enum": [
            "obs.unfinished",
            "obs.orphans",
            "obs.small",
            "obs.hot",
            "obs.listed",
            "obs.headget",
            "obs.deletes",
            "obs.rmw",
            "obs.polled",
            "obs.rename",
            "obs.markers",
            "obs.throttled",
            "obs.serial"
          ],
          "description": "What kind of finding it is, as `identity` begins (docs/cli.md#findings)."
        },
        "saving": {
          "$ref": "#/$defs/phrase"
        },
        "savingText": {
          "type": "string",
          "description": "Display text, not stable."
        },
        "savesRequests": {
          "type": "integer"
        },
        "savesMs": {
          "type": "number"
        },
        "savesCost": {
          "type": "number",
          "description": "What the requests it would save cost, in the run's currency (times `month.times`: a month)."
        },
        "fixes": {
          "type": "array",
          "description": "How to fix it: the fix for the run's SDK, or a store's setting (each SDK's with `--all`, or when no SDK is known).",
          "items": {
            "type": "object",
            "properties": {
              "sdk": {
                "type": "string",
                "description": "`python`, `java`, `go`, `js`, or `config` for a store's setting."
              },
              "code": {
                "type": "string",
                "description": "The change, with placeholders (`b` the bucket, `k` the key)."
              }
            },
            "required": [
              "sdk",
              "code"
            ]
          }
        },
        "callers": {
          "type": "array",
          "description": "Where its requests were sent from, most first (three at most): a place in the program's code when the run named callers; for an imported log, who sent them (an IAM principal).",
          "items": {
            "type": "object",
            "properties": {
              "place": {
                "type": "string",
                "description": "As the program or the log said it: `etl.py:25 process`, `arn:aws:iam::1:role/etl`."
              },
              "file": {
                "type": "string",
                "description": "The file, relative to the folder the program ran in (`run.cwd`), when `place` is a place in code."
              },
              "line": {
                "type": "integer"
              },
              "function": {
                "type": "string"
              },
              "requests": {
                "type": "integer",
                "description": "How many of its requests were sent from there."
              },
              "code": {
                "type": "string",
                "description": "The line of code itself, when the file is there to read."
              }
            },
            "required": [
              "place",
              "requests"
            ]
          }
        },
        "sdk": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "text",
        "phrases",
        "operations",
        "impact",
        "operationsTotal"
      ]
    },
    "kindSummary": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "misses": {
          "type": "integer",
          "description": "404s that answer a lookup."
        },
        "errorShare": {
          "type": "number"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "p99Ms": {
          "type": "number"
        },
        "maxMs": {
          "type": "number"
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "few": {
          "type": "boolean",
          "description": "Too few requests for its percentiles to say much."
        }
      },
      "required": [
        "kind",
        "count",
        "errors",
        "misses",
        "errorShare",
        "p50Ms",
        "p95Ms",
        "p99Ms",
        "maxMs",
        "bytesUp",
        "bytesDown"
      ]
    },
    "phrase": {
      "type": "object",
      "description": "A sentence as a key and its arguments: the app says it in the reader's language.",
      "properties": {
        "key": {
          "type": "string",
          "description": "The phrase's key in the app's locales (en, zh)."
        },
        "args": {
          "type": "object",
          "description": "Its arguments, as text.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "key"
      ]
    },
    "runHeader": {
      "type": "object",
      "description": "The run's first line: docs/dev/run-format.md.",
      "properties": {
        "format": {
          "type": "string",
          "description": "Always `sonde-run`.",
          "const": "sonde-run"
        },
        "version": {
          "type": "integer",
          "description": "The run format's version (docs/dev/run-format.md)."
        },
        "sonde": {
          "type": "string",
          "description": "The sonde that wrote the file (its version)."
        },
        "created": {
          "type": "string",
          "description": "When the recording began (RFC 3339)."
        },
        "endpoint": {
          "type": "string",
          "description": "The endpoint's id."
        },
        "url": {
          "type": "string",
          "description": "The endpoint's URL."
        },
        "region": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "description": "The command sonde ran, when it ran one."
        },
        "name": {
          "type": "string",
          "description": "The program's name (`[program] name`, `--name`)."
        },
        "cwd": {
          "type": "string",
          "description": "The folder the command ran in."
        },
        "git": {
          "$ref": "#/$defs/git"
        },
        "scenario": {
          "type": "string",
          "description": "A trial's fault scenario."
        },
        "trialOf": {
          "type": "string",
          "description": "The clean run a trial is of (its file name)."
        },
        "wholeSeconds": {
          "type": "boolean",
          "description": "Request times are to the second (an imported log)."
        }
      },
      "required": [
        "format",
        "version",
        "created",
        "endpoint",
        "url",
        "region"
      ]
    },
    "summary": {
      "type": "object",
      "description": "The run in figures.",
      "properties": {
        "requests": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "misses": {
          "type": "integer"
        },
        "refused": {
          "type": "integer",
          "description": "Refused by the recording's policy."
        },
        "seconds": {
          "type": "number",
          "description": "From the first request's start to the last one's end."
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "kinds": {
          "type": "array",
          "description": "Each kind of request.",
          "items": {
            "$ref": "#/$defs/kindSummary"
          }
        },
        "errorCodes": {
          "type": "array",
          "description": "Each error's status or code and its count.",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": [
                  "integer",
                  "string"
                ]
              },
              {
                "type": [
                  "integer",
                  "string"
                ]
              }
            ],
            "items": false
          }
        }
      },
      "required": [
        "requests",
        "errors",
        "misses",
        "refused",
        "seconds",
        "bytesUp",
        "bytesDown",
        "kinds",
        "errorCodes"
      ]
    },
    "whatIf": {
      "type": "object",
      "description": "The run as it is and as it would be with every finding's fix: each a pair.",
      "properties": {
        "requests": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "items": false
        },
        "waitingMs": {
          "type": [
            "array",
            "null"
          ],
          "description": "Null when the run's times cannot say it (an imported log's, to the second).",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "cost": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "currency": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "description": "Findings whose fix is counted."
        },
        "ofFindings": {
          "type": "integer"
        },
        "counted": {
          "type": "array",
          "description": "The findings counted.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "requests",
        "waitingMs",
        "cost",
        "currency",
        "findings",
        "ofFindings",
        "counted"
      ]
    },
    "trial": {
      "type": "object",
      "description": "A trial's verdict (docs/trials.md).",
      "properties": {
        "scenario": {
          "type": "string"
        },
        "about": {
          "type": "string"
        },
        "times": {
          "type": "integer"
        },
        "standing": {
          "type": "string",
          "enum": [
            "survived",
            "degraded",
            "broke",
            "untested",
            "refused"
          ],
          "description": "`refused`: the recording policy refused what the program did under the scenario (and not in its clean run): not judged, never `broke`."
        },
        "exit": {
          "type": "integer"
        },
        "cleanExit": {
          "type": "integer"
        },
        "faults": {
          "type": "integer"
        },
        "retried": {
          "type": "integer"
        },
        "attempts": {
          "type": "integer"
        },
        "history": {
          "type": "array",
          "description": "The scenario's verdicts for the program, oldest first, up to this one (`verdicts.json` beside its runs).",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "description": "When (RFC 3339)."
              },
              "standing": {
                "type": "string",
                "enum": [
                  "survived",
                  "degraded",
                  "broke",
                  "untested",
                  "refused"
                ]
              },
              "run": {
                "type": "string",
                "description": "The run's file name."
              }
            },
            "required": [
              "at",
              "standing",
              "run"
            ]
          }
        }
      },
      "required": [
        "scenario",
        "standing",
        "exit",
        "cleanExit",
        "faults",
        "retried"
      ]
    },
    "operation": {
      "type": "object",
      "description": "An operation: requests that belong together.",
      "properties": {
        "shape": {
          "type": "string",
          "description": "The shape of the operation: what its requests are together (a request alone, a multipart upload, a retry, lookups that found nothing, a listing over pages, a step of a storage format). `kind` is a request's S3 call only.",
          "enum": [
            "request",
            "multipart",
            "retry",
            "probe",
            "listing",
            "step"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "description": "The storage format a step is of (`iceberg`, `delta`, …)."
        },
        "title": {
          "type": "string",
          "description": "Display text, not stable."
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "description": "Its requests' ids.",
          "items": {
            "type": "integer"
          }
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "notes": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "type": "string"
          }
        },
        "notFound": {
          "type": "integer"
        },
        "titleText": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "notesText": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        }
      },
      "required": [
        "shape",
        "format",
        "title",
        "start",
        "end",
        "records",
        "bytesUp",
        "bytesDown",
        "outcome",
        "notes"
      ]
    },
    "header": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "refused"
          ]
        },
        "detail": {
          "type": "string",
          "description": "A failure's status and S3 code."
        }
      },
      "required": [
        "kind"
      ]
    },
    "record": {
      "type": "object",
      "description": "One request: a line of the run file (docs/dev/run-format.md).",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique within the run."
        },
        "time": {
          "type": "string",
          "description": "When the request began (RFC 3339)."
        },
        "endpoint": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "The request's kind: the S3 call (`GetObject`, `Unknown`)."
        },
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "The URL, signatures masked."
        },
        "bucket": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": "array",
          "description": "The query's pairs, signatures masked.",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false
          }
        },
        "status": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The HTTP status; null when no answer came."
        },
        "latencyMs": {
          "type": "number"
        },
        "retries": {
          "type": "integer"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostId": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestHeaders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/header"
          }
        },
        "responseHeaders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/header"
          }
        },
        "requestBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "responseBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "errorBody": {
          "type": [
            "string",
            "null"
          ],
          "description": "The error's body, up to 64 KiB."
        },
        "requestBody": {
          "type": "string",
          "description": "A control request's body (DeleteObjects, a lifecycle rule)."
        },
        "requestBodyTruncated": {
          "type": "boolean"
        },
        "transportError": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "job": {
          "type": [
            "string",
            "null"
          ]
