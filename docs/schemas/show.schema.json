              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "latency": {
          "type": "array",
          "description": "Each run's latency on the same buckets.",
          "prefixItems": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "leMs": {
                    "type": "number",
                    "description": "The bucket's upper edge."
                  },
                  "n": {
                    "type": "integer"
                  }
                },
                "required": [
                  "leMs",
                  "n"
                ]
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "leMs": {
                    "type": "number",
                    "description": "The bucket's upper edge."
                  },
                  "n": {
                    "type": "integer"
                  }
                },
                "required": [
                  "leMs",
                  "n"
                ]
              }
            }
          ],
          "items": false
        },
        "prefixes": {
          "type": "array",
          "description": "The busiest prefixes.",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string"
              },
              "requests": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "items": false
              }
            },
            "required": [
              "prefix",
              "requests"
            ]
          }
        },
        "failed": {
          "type": "integer",
          "description": "The exit code of a run compared that failed (the later's, when both did): its findings are not compared, and `findings`, `resolved` and `appeared` are empty."
        }
      },
      "required": [
        "requests",
        "wallMs",
        "waitingMs",
        "errors",
        "cost",
        "currency",
        "peakInFlight",
        "groups",
        "resolved",
        "appeared",
        "findings",
        "sameProgram",
        "waitingKnown",
        "latency",
        "prefixes"
      ]
    },
    "saving": {
      "type": "object",
      "description": "Requests not sent and time not waited, in ms.",
      "properties": {
        "requests": {
          "type": "integer"
        },
        "ms": {
          "type": "number"
        }
      },
      "required": [
        "requests",
        "ms"
      ]
    }
