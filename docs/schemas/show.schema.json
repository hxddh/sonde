                "description": "fixed: gone at any threshold; less and more: still there at any threshold, by its counts; back: fixed in an earlier run, or under its threshold in the run before, over it again; open: as much in both."
              },
              "level": {
                "enum": [
                  "warn",
                  "info"
                ]
              },
              "text": {
                "type": "string",
                "description": "Display text, not stable."
