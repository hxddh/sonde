{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/compare-answers.schema.json",
  "title": "sonde compare ORIGINAL REPLAY -f json",
  "description": "A recording and its replay: every answer compared.",
  "type": "object",
  "properties": {
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "latency": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/latencyChange"
      }
    },
    "relies": {
      "type": "array",
      "description": "When the replay asked them: what the program relies on, and how the store answered.",
      "items": {
        "$ref": "#/$defs/relied"
      }
    }
  },
  "required": [
    "comparison",
    "latency"
  ],
  "$defs": {
    "comparison": {
      "type": "object",
      "description": "Every answer of a replay against the recording's.",
      "properties": {
        "compared": {
          "type": "integer"
        },
        "same": {
          "type": "integer"
        },
        "environment": {
          "type": "integer",
          "description": "Differences of the store's set-up, not its behaviour."
        },
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/difference"
          }
        },
        "unmatched": {
          "type": "object",
          "description": "Requests with no counterpart, by why.",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "compared",
        "same",
        "environment",
        "differences",
        "unmatched"
      ]
    },
    "difference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "original": {
          "type": "string",
          "description": "The recorded answer."
        },
        "replay": {
          "type": "string",
          "description": "The replay's."
        },
        "count": {
          "type": "integer"
        },
        "example": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "original",
        "replay",
        "count",
        "example",
        "conditions"
      ]
    },
    "latencyChange": {
      "type": "object",
      "description": "A kind of request in two runs: each figure a pair (first, second).",
      "properties": {
        "kind": {
          "type": "string"
        },
        "missed": {
          "type": "boolean"
        },
        "requests": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "items": false
        },
        "p50Ms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "p95Ms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "waitingMs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        }
      },
      "required": [
        "kind",
        "missed",
        "requests",
        "p50Ms",
        "p95Ms",
        "waitingMs"
      ]
    },
    "phrase": {
      "type": "object",
      "description": "A sentence as a key and its arguments: the app says it in the reader's language.",
      "properties": {
        "key": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "key"
      ]
    },
    "relied": {
      "type": "object",
      "description": "A feature the run used, the probe that checks it, and how the store answered it.",
      "properties": {
        "probe": {
          "type": "string",
          "description": "The probe's id (`sonde probe list`)."
        },
        "kind": {
          "type": "string",
          "description": "The kind of request that showed it first."
        },
        "requests": {
          "type": "integer",
          "description": "How many requests used it."
        },
        "seen": {
          "type": "string",
          "description": "What showed it: a header as sent, a batch's size."
        },
        "seenText": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "title": {
          "type": "string"
        },
        "titleText": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "differs",
            "unsupported",
            "error",
            "skipped"
          ]
        },
        "summary": {
          "type": "string"
        },
        "summaryText": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        }
      },
      "required": [
        "probe",
        "kind",
        "requests",
        "seen",
        "title",
        "verdict",
        "summary"
      ]
    }
  }
}
