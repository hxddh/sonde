{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/compare.schema.json",
  "title": "sonde compare -f json",
  "description": "Two runs of a program, before and after a change: each figure a pair (before, after).",
  "type": "object",
  "properties": {
    "requests": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false
    },
    "wallMs": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "waitingMs": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "errors": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false
    },
    "cost": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "currency": {
      "type": "string"
    },
    "peakInFlight": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false
    },
    "groups": {
      "type": "array",
      "description": "Kinds of request, the largest change first.",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "missed": {
            "type": "boolean"
          },
          "requests": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "items": false
          },
          "waitingMs": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false
          }
        },
        "required": [
          "operation",
          "missed",
          "requests",
          "waitingMs"
        ]
      }
    },
    "resolved": {
      "type": "array",
      "description": "Findings the second run no longer has at any threshold (fixed).",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "phrases": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/phrase"
            }
          }
        },
        "required": [
          "text",
          "phrases"
        ]
      }
    },
    "appeared": {
      "type": "array",
      "description": "Findings only the second run has.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "phrases": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/phrase"
            }
          }
        },
        "required": [
          "text",
          "phrases"
        ]
      }
    },
    "findings": {
      "type": "array",
      "description": "Each finding of either run, where it stands: fixed first, then less, back, new, more, open; then each kind of failure whose count moved (`obs.errors|500 InternalError`).",
      "items": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "string",
            "description": "The same finding across runs: its kind and what it is about ([fix loop](../cli.md#the-fix-loop))."
          },
          "state": {
            "enum": [
              "fixed",
              "less",
              "more",
              "back",
              "new",
              "open"
            ],
            "description": "fixed: gone at any threshold; less and more: by its counts (less also: under its threshold now); back: fixed in an earlier run, or under its threshold in the run before, over it again; open: as much in both."
          },
          "level": {
            "enum": [
              "warn",
              "info"
            ]
          },
          "text": {
            "type": "string"
          },
          "phrases": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/phrase"
            }
          },
          "was": {
            "type": "object",
            "description": "As it read in the run before, when it reads otherwise now (less, more, back).",
            "properties": {
              "text": {
                "type": "string"
              },
              "phrases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/phrase"
                }
              }
            },
            "required": [
              "text",
              "phrases"
            ]
          },
          "counts": {
            "type": "array",
            "description": "How much of it each run had (times listed, requests throttled or failed), the run before first.",
            "items": {
              "type": "integer"
            }
          },
          "predicted": {
            "$ref": "#/$defs/saving",
            "description": "What acting on it was predicted to save."
          },
          "measured": {
            "$ref": "#/$defs/saving",
            "description": "What it saved, measured between the runs (fixed, less)."
          },
          "saved": {
            "$ref": "#/$defs/phrase"
          },
          "savedText": {
            "type": "string",
            "description": "The measured saving against the predicted."
          }
        },
        "required": [
          "identity",
          "state",
          "level",
          "text",
          "phrases",
          "predicted"
        ]
      }
    },
    "sameProgram": {
      "type": "boolean",
      "description": "Both are runs of one program: their findings compare."
    },
    "latency": {
      "type": "array",
      "description": "Each run's latency on the same buckets.",
      "prefixItems": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "leMs": {
                "type": "number",
                "description": "The bucket's upper edge."
              },
              "n": {
                "type": "integer"
              }
            },
            "required": [
              "leMs",
              "n"
            ]
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "leMs": {
                "type": "number",
                "description": "The bucket's upper edge."
              },
              "n": {
                "type": "integer"
              }
            },
            "required": [
              "leMs",
              "n"
            ]
          }
        }
      ],
      "items": false
    },
    "prefixes": {
      "type": "array",
      "description": "The busiest prefixes.",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string"
          },
          "requests": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "items": false
          }
        },
        "required": [
          "prefix",
          "requests"
        ]
      }
    },
    "failed": {
      "type": "integer",
      "description": "The exit code of a run compared that failed (the later's, when both did): its findings are not compared, and `findings`, `resolved` and `appeared` are empty."
    }
  },
  "required": [
    "requests",
    "wallMs",
    "waitingMs",
    "errors",
    "cost",
    "currency",
    "peakInFlight",
    "groups",
    "resolved",
    "appeared",
    "findings",
    "sameProgram",
    "latency",
    "prefixes"
  ],
  "$defs": {
    "phrase": {
      "type": "object",
      "description": "A sentence as a key and its arguments: the app says it in the reader's language.",
      "properties": {
        "key": {
          "type": "string",
          "description": "The phrase's key in the app's locales (en, zh)."
        },
        "args": {
          "type": "object",
          "description": "Its arguments, as text.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "key"
      ]
    },
    "saving": {
      "type": "object",
      "description": "Requests not sent and time not waited, in ms.",
      "properties": {
        "requests": {
          "type": "integer"
        },
        "ms": {
          "type": "number"
        }
      },
      "required": [
        "requests",
        "ms"
      ]
    }
  }
}
