{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/show-summary.schema.json",
  "title": "sonde show --summary -f json",
  "description": "What a session amounts to, without its requests.",
  "type": "object",
  "properties": {
    "session": {
      "$ref": "#/$defs/sessionHeader"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "operations": {
      "type": "integer",
      "description": "How many operations (`operations` in `show -f json`)."
    },
    "waiting": {
      "type": "object",
      "description": "How long the program waited on the store.",
      "properties": {
        "waitingMs": {
          "type": "number",
          "description": "Time with any request in flight."
        },
        "wallMs": {
          "type": "number",
          "description": "The run's length."
        },
        "peakInFlight": {
          "type": "integer"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "p99Ms": {
          "type": "number"
        },
        "byKind": {
          "type": "array",
          "description": "Each kind of request's share.",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      },
      "required": [
        "waitingMs",
        "wallMs",
        "peakInFlight",
        "p50Ms",
        "p95Ms",
        "p99Ms",
        "byKind"
      ]
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "whatIf": {
      "$ref": "#/$defs/whatIf"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "trials": {
      "type": "array",
      "description": "The run's last trial, scenario by scenario, each with its history (`sonde run --trial`).",
      "items": {
        "$ref": "#/$defs/trial"
      }
    },
    "since": {
      "type": [
        "object",
        "null"
      ],
      "description": "The run against its program's run before it, as `show` says it under \"since the run before\": `program`, `previous`, `change` (as `compare -f json`), `findings` (each with its `state`: fixed, less, back, new, open), or `failed` (the exit code of a run that failed: not compared). Null for a session that is no run of a program."
    }
  },
  "required": [
    "session",
    "summary",
    "operations",
    "waiting",
    "cost",
    "whatIf",
    "findings",
    "trials"
  ],
  "$defs": {
    "cost": {
      "type": "object",
      "description": "The requests' cost at the endpoint's prices.",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "reads": {
          "type": "integer"
        },
        "writes": {
          "type": "integer"
        },
        "free": {
          "type": "integer"
        }
      },
      "required": [
        "amount",
        "currency",
        "reads",
        "writes",
        "free"
      ]
    },
    "git": {
      "type": "object",
      "description": "The commit the program's code was at.",
      "properties": {
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean",
          "description": "Changes not committed yet."
        }
      },
      "required": [
        "commit",
        "dirty"
      ]
    },
    "group": {
      "type": "object",
      "description": "A kind of request.",
      "properties": {
        "operation": {
          "type": "string"
        },
        "missed": {
          "type": "boolean",
          "description": "Lookups that found nothing, apart."
        },
        "requests": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "busyMs": {
          "type": "number",
          "description": "Time with one of these in flight."
        },
        "sumMs": {
          "type": "number"
        },
        "waitedMs": {
          "type": "number"
        },
        "share": {
          "type": "number"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "maxMs": {
          "type": "number"
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "cost": {
          "type": "number"
        }
      },
      "required": [
        "operation",
        "missed",
        "requests",
        "errors",
        "busyMs",
        "p50Ms",
        "p95Ms"
      ]
    },
    "observation": {
      "type": "object",
      "description": "A finding.",
      "properties": {
        "level": {
          "type": "string",
          "description": "`warn` (likely a problem) or `info`.",
          "enum": [
            "warn",
            "info"
          ]
        },
        "text": {
          "type": "string",
          "description": "In English."
        },
        "phrases": {
          "type": "array",
          "description": "The same, as phrases.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "episodes": {
          "type": "array",
          "description": "The operations it is about (their places in `episodes`).",
          "items": {
            "type": "integer"
          }
        },
        "impact": {
          "type": "integer",
          "description": "Requests it is about."
        },
        "identity": {
          "type": "string",
          "description": "The same finding across runs: what `[check] expect` names."
        },
        "saving": {
          "$ref": "#/$defs/phrase"
        },
        "savingText": {
          "type": "string"
        },
        "savesRequests": {
          "type": "integer"
        },
        "savesMs": {
          "type": "number"
        },
        "fixes": {
          "type": "array",
          "description": "How to fix it.",
          "items": {
            "type": "object",
            "description": "A change to the program's code, for an SDK."
          }
        },
        "callers": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A place in the program's code."
          }
        },
        "sdk": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "text",
        "phrases",
        "episodes",
        "impact"
      ]
    },
    "operationSummary": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "misses": {
          "type": "integer",
          "description": "404s that answer a lookup."
        },
        "errorShare": {
          "type": "number"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "p99Ms": {
          "type": "number"
        },
        "maxMs": {
          "type": "number"
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "few": {
          "type": "boolean",
          "description": "Too few requests for its percentiles to say much."
        }
      },
      "required": [
        "operation",
        "count",
        "errors",
        "misses",
        "errorShare",
        "p50Ms",
        "p95Ms",
        "p99Ms",
        "maxMs",
        "bytesUp",
        "bytesDown",
        "few"
      ]
    },
    "phrase": {
      "type": "object",
      "description": "A sentence as a key and its arguments: the app says it in the reader's language.",
      "properties": {
        "key": {
          "type": "string",
          "description": "The phrase's key in the app's locales (en, zh)."
        },
        "args": {
          "type": "object",
          "description": "Its arguments, as text.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "key"
      ]
    },
    "sessionHeader": {
      "type": "object",
      "description": "The session's first line: docs/session-format.md.",
      "properties": {
        "format": {
          "type": "string",
          "description": "Always `sonde-session`.",
          "const": "sonde-session"
        },
        "version": {
          "type": "integer",
          "description": "The session format's version (docs/session-format.md)."
        },
        "sonde": {
          "type": "string",
          "description": "The sonde that wrote the file (its version)."
        },
        "created": {
          "type": "string",
          "description": "When the recording began (RFC 3339)."
        },
        "endpoint": {
          "type": "string",
          "description": "The endpoint's id."
        },
        "url": {
          "type": "string",
          "description": "The endpoint's URL."
        },
        "region": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "description": "The command sonde ran, when it ran one."
        },
        "name": {
          "type": "string",
          "description": "The program's name (`[program] name`, `--name`)."
        },
        "cwd": {
          "type": "string",
          "description": "The folder the command ran in."
        },
        "git": {
          "$ref": "#/$defs/git"
        },
        "scenario": {
          "type": "string",
          "description": "A trial's fault scenario."
        },
        "trialOf": {
          "type": "string",
          "description": "The clean run a trial is of (its file name)."
        },
        "wholeSeconds": {
          "type": "boolean",
          "description": "Request times are to the second (an imported log)."
        }
      },
      "required": [
        "format",
        "version",
        "created",
        "endpoint",
        "url",
        "region"
      ]
    },
    "summary": {
      "type": "object",
      "description": "The session in figures.",
      "properties": {
        "requests": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "misses": {
          "type": "integer"
        },
        "refused": {
          "type": "integer",
          "description": "Refused by the recording's policy."
        },
        "seconds": {
          "type": "number",
          "description": "From the first request's start to the last one's end."
        },
        "bytesUp": {
          "type": "integer"
        },
        "bytesDown": {
          "type": "integer"
        },
        "operations": {
          "type": "array",
          "description": "Each kind of request.",
          "items": {
            "$ref": "#/$defs/operationSummary"
          }
        },
        "errorCodes": {
          "type": "array",
          "description": "Each error's status or code and its count.",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": [
                  "integer",
                  "string"
                ]
              },
              {
                "type": [
                  "integer",
                  "string"
                ]
              }
            ],
            "items": false
          }
        }
      },
      "required": [
        "requests",
        "errors",
        "misses",
        "refused",
        "seconds",
        "bytesUp",
        "bytesDown",
        "operations",
        "errorCodes"
      ]
    },
    "whatIf": {
      "type": "object",
      "description": "The run as it is and as it would be with every finding's fix: each a pair.",
      "properties": {
        "requests": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "items": false
        },
        "waitingMs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "cost": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "currency": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "description": "Findings whose fix is counted."
        },
        "ofFindings": {
          "type": "integer"
        },
        "counted": {
          "type": "array",
          "description": "The findings counted.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "requests",
        "waitingMs",
        "cost",
        "currency",
        "findings",
        "ofFindings",
        "counted"
      ]
    },
    "trial": {
      "type": "object",
      "description": "A trial's verdict (docs/trials.md).",
      "properties": {
        "scenario": {
          "type": "string"
        },
        "about": {
          "type": "string"
        },
        "times": {
          "type": "integer"
        },
        "standing": {
          "type": "string",
          "enum": [
            "survived",
            "degraded",
            "broke",
            "untested",
            "refused"
          ],
          "description": "`refused`: the recording policy refused what the program did under the scenario (and not in its clean run): not judged, never `broke`."
        },
        "exit": {
          "type": "integer"
        },
        "cleanExit": {
          "type": "integer"
        },
        "faults": {
          "type": "integer"
        },
        "retried": {
          "type": "integer"
        },
        "attempts": {
          "type": "integer"
        },
        "history": {
          "type": "array",
          "description": "The scenario's verdicts for the program, oldest first, up to this one (`verdicts.json` beside its runs).",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "description": "When (RFC 3339)."
              },
              "standing": {
                "type": "string",
                "enum": [
                  "survived",
                  "degraded",
                  "broke",
                  "untested",
                  "refused"
                ]
              },
              "run": {
                "type": "string",
                "description": "The run's session file name."
              }
            },
            "required": [
              "at",
              "standing",
              "run"
            ]
          }
        }
      },
      "required": [
        "scenario",
        "standing",
        "exit",
        "cleanExit",
        "faults",
        "retried"
      ]
    }
  }
}
