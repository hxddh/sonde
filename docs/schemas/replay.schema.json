{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/replay.schema.json",
  "title": "sonde replay RUN -e ENDPOINT -f json",
  "description": "A run replayed on one endpoint, cleaned up and compared. Exit 2 when answers differ.",
  "type": "object",
  "properties": {
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "run": {
      "type": "string",
      "description": "The replay's own run."
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "removed": {
      "type": "integer",
      "description": "Objects the cleanup removed."
    },
    "removedVersions": {
      "type": "integer"
    },
    "remaining": {
      "type": "integer",
      "description": "What the cleanup could not remove."
    },
    "remainingObjects": {
      "type": "integer"
    },
    "remainingVersions": {
      "type": "integer"
    },
    "remainingMarkers": {
      "type": "integer"
    },
    "unabortedUploads": {
      "type": "integer"
    },
    "relies": {
      "type": "array",
      "description": "What the program relies on (only the probes matching features its requests used), run against the store.",
      "items": {
        "$ref": "#/$defs/relied"
      }
    },
    "cost": {
      "type": "array",
      "description": "Each store's request cost, the recording's first.",
      "items": {
        "$ref": "#/$defs/cost"
      }
    }
  },
  "required": [
    "plan",
    "run",
    "comparison",
    "removed",
    "removedVersions",
    "remaining",
    "remainingObjects",
    "remainingVersions",
    "remainingMarkers",
    "unabortedUploads",
    "relies",
    "cost"
  ],
  "$defs": {
    "comparison": {
      "type": "object",
      "description": "Every answer of a replay against the recording's.",
      "properties": {
        "compared": {
          "type": "integer"
        },
        "same": {
          "type": "integer"
        },
        "environment": {
          "type": "integer",
          "description": "Differences of the store's set-up, not its behaviour."
        },
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/difference"
          }
        },
        "unmatched": {
          "type": "object",
          "description": "Requests with no counterpart, by why.",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "compared",
        "same",
        "environment",
        "differences",
        "unmatched"
      ]
    },
    "cost": {
      "type": "object",
      "description": "A store's request cost for the run, at its vendor's prices.",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "amount",
        "currency"
      ]
    },
    "difference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "original": {
          "type": "string",
          "description": "The recorded answer."
        },
        "replay": {
          "type": "string",
          "description": "The replay's."
        },
        "count": {
          "type": "integer"
        },
        "example": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "original",
        "replay",
        "count",
        "example",
        "conditions"
      ]
    },
    "phrase": {
      "type": "object",
      "description": "A sentence as a key and its arguments: the app says it in the reader's language.",
      "properties": {
        "key": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "key"
      ]
    },
    "plan": {
      "type": "object",
      "description": "What a replay sends.",
      "properties": {
        "requests": {
          "type": "integer"
        },
        "writes": {
          "type": "integer"
        },
        "deletes": {
          "type": "integer"
        },
        "skipped": {
          "type": "object",
          "description": "Requests not replayed, by why.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "seeds": {
          "type": "integer",
          "description": "Stand-ins written first, of the recorded size, for what the run read and had not written."
        },
        "seedBytes": {
          "type": "integer"
        }
      },
      "required": [
        "requests",
        "writes",
        "deletes",
        "skipped",
        "seeds",
        "seedBytes"
      ]
    },
    "relied": {
      "type": "object",
      "description": "A feature the run used, the probe that checks it, and how the store answered it.",
      "properties": {
        "probe": {
          "type": "string",
          "description": "The probe's id ([probes.md](https://github.com/hxddh/sonde/blob/main/docs/probes.md))."
        },
        "kind": {
          "type": "string",
          "description": "The kind of request that showed it first."
        },
        "requests": {
          "type": "integer",
          "description": "How many requests used it."
        },
        "seen": {
          "type": "string",
          "description": "What showed it: a header as sent, a batch's size."
        },
        "seenText": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "title": {
          "type": "string"
        },
        "titleText": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "differs",
            "unsupported",
            "error",
            "skipped"
          ]
        },
        "summary": {
          "type": "string"
        },
        "summaryText": {
          "type": "array",
          "description": "Display text, not stable.",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        }
      },
      "required": [
        "probe",
        "kind",
        "requests",
        "seen",
        "title",
        "verdict",
        "summary"
      ]
    }
  }
}
