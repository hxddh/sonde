{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/compare-replay.schema.json",
  "title": "sonde compare FILE --replay ENDPOINT -f json",
  "description": "A session replayed on one endpoint, cleaned up and compared. Exit 2 when answers differ.",
  "type": "object",
  "properties": {
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "session": {
      "type": "string",
      "description": "The replay's own session."
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "removed": {
      "type": "integer",
      "description": "Objects the cleanup removed."
    },
    "removedVersions": {
      "type": "integer"
    },
    "remaining": {
      "type": "integer",
      "description": "What the cleanup could not remove."
    },
    "remainingObjects": {
      "type": "integer"
    },
    "remainingVersions": {
      "type": "integer"
    },
    "remainingMarkers": {
      "type": "integer"
    },
    "unabortedUploads": {
      "type": "integer"
    }
  },
  "required": [
    "plan",
    "session",
    "comparison",
    "removed",
    "removedVersions",
    "remaining",
    "remainingObjects",
    "remainingVersions",
    "remainingMarkers",
    "unabortedUploads"
  ],
  "$defs": {
    "comparison": {
      "type": "object",
      "description": "Every answer of a replay against the recording's.",
      "properties": {
        "compared": {
          "type": "integer"
        },
        "same": {
          "type": "integer"
        },
        "environment": {
          "type": "integer",
          "description": "Differences of the store's set-up, not its behaviour."
        },
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/difference"
          }
        },
        "unmatched": {
          "type": "object",
          "description": "Requests with no counterpart, by why.",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "compared",
        "same",
        "environment",
        "differences",
        "unmatched"
      ]
    },
    "difference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "original": {
          "type": "string",
          "description": "The recorded answer."
        },
        "replay": {
          "type": "string",
          "description": "The replay's."
        },
        "count": {
          "type": "integer"
        },
        "example": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "original",
        "replay",
        "count",
        "example",
        "conditions"
      ]
    },
    "plan": {
      "type": "object",
      "description": "What a replay sends.",
      "properties": {
        "requests": {
          "type": "integer"
        },
        "writes": {
          "type": "integer"
        },
        "deletes": {
          "type": "integer"
        },
        "skipped": {
          "type": "object",
          "description": "Requests not replayed, by why.",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "requests",
        "writes",
        "deletes",
        "skipped"
      ]
    }
  }
}
