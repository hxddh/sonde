{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hxddh/sonde/main/docs/schemas/show-by.schema.json",
  "title": "sonde show --by DIMENSION -f json",
  "description": "A run's requests split by one dimension: each group's figures (as `summary.kinds` has them), and where the slow and the costly requests concentrate.",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "#/$defs/runHeader"
    },
    "split": {
      "type": "object",
      "properties": {
        "by": {
          "enum": [
            "kind",
            "prefix",
            "size",
            "caller",
            "key"
          ]
        },
        "sdk": {
          "type": [
            "string",
            "null"
          ],
          "description": "The SDK that sent most requests (`boto3 1.44`), from their user agent."
        },
        "slowMs": {
          "type": "number",
          "description": "A request this slow or slower is slow: the run's p90 (0 with fewer than 3 such requests)."
        },
        "slow": {
          "type": "integer",
          "description": "Slow requests."
        },
        "cost": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "description": "Most waiting first; past 12 groups the rest is one row, `other`, last.",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "text": {
          "type": "string",
          "description": "Display text, not stable: where the slow and the costly requests concentrate, in a sentence (empty when nothing can be said)."
        },
        "phrases": {
          "type": "array",
          "description": "Display text, not stable: `text` as phrases, for other languages.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "description": "Its arguments, as text.",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "key",
              "args"
            ]
          }
        }
      },
      "required": [
        "by",
        "sdk",
        "slowMs",
        "slow",
        "cost",
        "currency",
        "rows",
        "text",
        "phrases"
      ]
    }
  },
  "required": [
    "run",
    "split"
  ],
  "$defs": {
    "row": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "The kind, prefix, size band (`0 B`, `< 64 KiB`, `64 KiB-1 MiB`, `1-8 MiB`, `8 MiB+`), caller or object (bucket/key)."
        },
        "other": {
          "type": "boolean",
          "description": "The groups past the table's rows, folded into one."
        },
        "requests": {
          "type": "integer"
        },
        "errors": {
          "type": "integer",
          "description": "Failed requests (a lookup that found nothing is no failure)."
        },
        "errorShare": {
          "type": "number"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "p99Ms": {
          "type": "number"
        },
        "waitedMs": {
          "type": "number",
          "description": "The program's waiting that was theirs."
        },
        "share": {
          "type": "number",
          "description": "Of the run's waiting; the rows add up to 1."
        },
        "cost": {
          "type": "number"
        },
        "costShare": {
          "type": "number"
        },
        "slow": {
          "type": "integer"
        }
      },
      "required": [
        "key",
        "requests",
        "errors",
        "errorShare",
        "p50Ms",
        "p95Ms",
        "p99Ms",
        "waitedMs",
        "share",
        "cost",
        "costShare",
        "slow"
      ]
    },
    "runHeader": {
      "type": "object",
      "description": "The run's first line: docs/dev/run-format.md.",
      "properties": {
        "format": {
          "type": "string",
          "description": "Always `sonde-run`.",
          "const": "sonde-run"
        },
        "version": {
          "type": "integer",
          "description": "The run format's version (docs/dev/run-format.md)."
        },
        "sonde": {
          "type": "string",
          "description": "The sonde that wrote the file (its version)."
        },
        "created": {
          "type": "string",
          "description": "When the recording began (RFC 3339)."
        },
        "endpoint": {
          "type": "string",
          "description": "The endpoint's id."
        },
        "url": {
          "type": "string",
          "description": "The endpoint's URL."
        },
        "region": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "description": "The command sonde ran, when it ran one."
        },
        "name": {
          "type": "string",
          "description": "The program's name (`[program] name`, `--name`)."
        },
        "cwd": {
          "type": "string",
          "description": "The folder the command ran in."
        },
        "git": {
          "$ref": "#/$defs/git"
        },
        "scenario": {
          "type": "string",
          "description": "A trial's fault scenario."
        },
        "trialOf": {
          "type": "string",
          "description": "The clean run a trial is of (its file name)."
        },
        "wholeSeconds": {
          "type": "boolean",
          "description": "Request times are to the second (an imported log)."
        },
        "pathStyle": {
          "type": "boolean",
          "description": "The store was given by its URL (`--url`) and addressed path-style (`--path-style`). Absent otherwise (33.0)."
        },
        "caFile": {
          "type": "string",
          "description": "The CA file a store given by its URL was trusted by (`--ca-file`): its path, never its content. Absent otherwise (33.0)."
        },
        "tls": {
          "type": "boolean",
          "description": "The program was served TLS (`--tls`). Absent otherwise (33.0)."
        },
        "policy": {
          "type": "string",
          "description": "What the recorded program was allowed to do: `allow`, `no-delete` or `read-only`. Absent in a run written before 33.0, and in one no program was recorded for (an import, a replay)."
        }
      },
      "required": [
        "format",
        "version",
        "created",
        "endpoint",
        "url",
        "region"
      ]
    },
    "git": {
      "type": "object",
      "description": "The commit the program's code was at.",
      "properties": {
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean",
          "description": "Changes not committed yet."
        }
      },
      "required": [
        "commit",
        "dirty"
      ]
    }
  }
}
