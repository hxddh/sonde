{
  "name": "sonde",
  "id": "dev.sonde.app",
  "version": "11.0.0",
  "build": 14,
  "icon": "assets/icon.png",
  "rust": "../crates/sonde-nsh",
  "schemes": ["sonde"],
  "locales": ["zh"],
  "theme": "theme.json",
  "tailwind": {
    "fontSize": {
      "caption": 11,
      "small": 12,
      "body": 13,
      "heading": 15,
      "title": 20
    }
  },
  "capabilities": {
    "clipboard": true,
    "notifications": true,
    "windows": true,
    "statusBar": true,
    "picker": true,
    "openUrl": { "schemes": ["http", "https"] }
  },
  "macos": {
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.developer-tools",
      "NSHumanReadableCopyright": "Apache-2.0"
    }
  },
  "tui": {
    "pointsPerCell": "8x16"
  },
  "window": {
    "title": "sonde",
    "defaultSize": {
      "width": 1280,
      "height": 820
    },
    "minSize": {
      "width": 900,
      "height": 560
    },
    "titleBar": {
      "style": "hidden",
      "height": 44
    },
    "backdrop": "sidebar",
    "restoreBounds": true
  },
  "updater": {
    "github": "hxddh/sonde"
  }
}
