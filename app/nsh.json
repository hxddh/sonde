{
  "name": "sonde",
  "id": "dev.sonde.app",
  "version": "3.0.0",
  "build": 5,
  "icon": "assets/icon.png",
  "rust": "../crates/sonde-nsh",
  "theme": "theme.json",
  "capabilities": {
    "clipboard": true,
    "notifications": true,
    "windows": true,
    "statusBar": true,
    "picker": true
  },
  "macos": {
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.developer-tools",
      "NSHumanReadableCopyright": "Apache-2.0"
    }
  },
  "tui": {
    "pointsPerCell": "8x16"
  },
  "window": {
    "title": "sonde",
    "defaultSize": {
      "width": 1280,
      "height": 820
    },
    "minSize": {
      "width": 900,
      "height": 560
    },
    "titleBar": {
      "style": "hidden",
      "height": 44
    }
  },
  "updater": {
    "github": "hxddh/sonde"
  }
}
