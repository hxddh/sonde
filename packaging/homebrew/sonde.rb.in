# Generated by scripts/update-tap.sh from packaging/homebrew/sonde.rb.in.
class Sonde < Formula
  desc "Diagnose S3 and S3-compatible object storage (terminal UI and CLI)"
  homepage "https://github.com/hxddh/sonde"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/hxddh/sonde/releases/download/v@VERSION@/sonde-macos-aarch64.tar.gz"
      sha256 "@SHA_MACOS_ARM@"
    end
    on_intel do
      url "https://github.com/hxddh/sonde/releases/download/v@VERSION@/sonde-macos-x86_64.tar.gz"
      sha256 "@SHA_MACOS_X86@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hxddh/sonde/releases/download/v@VERSION@/sonde-linux-aarch64.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    end
    on_intel do
      url "https://github.com/hxddh/sonde/releases/download/v@VERSION@/sonde-linux-x86_64.tar.gz"
      sha256 "@SHA_LINUX_X86@"
    end
  end

  def install
    bin.install "sonde"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/sonde --version")
    assert_match "probe", shell_output("#{bin}/sonde probe list")
  end
end
